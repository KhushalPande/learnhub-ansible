<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ app_name }} - {{ app_tagline }}</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 0; background: #f4f7fb; color: #1f2d3d; }
    header { background: #1f4e79; color: #fff; padding: 36px 24px; text-align: center; }
    header h1 { margin: 0 0 6px; font-size: 2.2em; }
    main { max-width: 820px; margin: 28px auto; padding: 0 16px; }
    .card { background: #fff; border-radius: 8px; padding: 16px 20px; margin-bottom: 14px;
            box-shadow: 0 1px 4px rgba(0,0,0,.12); display: flex; justify-content: space-between; }
    .tag { background: #e3eefa; color: #1f4e79; border-radius: 12px; padding: 2px 10px; font-size: .85em; }
    footer { text-align: center; color: #667; font-size: .85em; padding: 20px; }
  </style>
</head>
<body>
  <header>
    <h1>{{ app_name }}</h1>
    <p>{{ app_tagline }}</p>
  </header>
  <main>
    <h2>Featured Courses</h2>
{% for c in courses %}
    <div class="card">
      <div><strong>{{ c.title }}</strong><br><span class="tag">{{ c.level }}</span></div>
      <div>{{ c.hours }} hours</div>
    </div>
{% endfor %}
  </main>
  <footer>
    Deployed with Ansible | Version {{ app_version }} | Environment: {{ app_env }} | Host: {{ ansible_hostname }}
  </footer>
</body>
</html>
